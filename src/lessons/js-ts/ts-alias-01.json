    },
    {
      "code": "  return Math.sqrt(p.x ** 2 + p.y ** 2);",
      "explain": "Distance from zero"
    },
    {
      "code": "}",
      "explain": "End of function"
    },
    {
      "code": "console.log(userId, dist(zero));",
