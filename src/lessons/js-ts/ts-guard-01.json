    },
    {
      "code": "function isCat(a: Cat | Dog): a is Cat {",
      "explain": "Type predicate"
    },
    {
      "code": "  return \"meow\" in a;",
      "explain": "Check for meow"
    },
    {
      "code": "}",
      "explain": "End of guard"
    },
    {
      "code": "function talk(a: Cat | Dog): void {",
      "explain": "Accept either"
    },
    {
      "code": "  if (isCat(a)) a.meow();",
