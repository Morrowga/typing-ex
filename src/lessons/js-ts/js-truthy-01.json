  "chunks": [
    {
      "code": "const name = \"\";",
      "explain": "An empty string is falsy"
    },
    {
      "code": "const shown = name || \"Guest\";",
      "explain": "Fallback if falsy"
    },
    {
      "code": "const qty = 0;",
      "explain": "Zero is falsy too"
    },
    {
      "code": "const safe = qty ?? 10;",
      "explain": "Fallback only if null"
    },
    {
      "code": "const label = qty > 0 ? \"in stock\" : \"sold out\";",
      "explain": "Ternary picks one"
    },
    {
      "code": "const user = { profile: null };",
      "explain": "Missing profile"
    },
    {
      "code": "console.log(user.profile?.email);",
      "explain": "Optional chaining: undefined"
    }
  ]
}
