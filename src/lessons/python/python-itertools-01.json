    },
    {
      "code": "print(list(islice(range(100), 3)))",
      "explain": "Take the first 3: [0, 1, 2]"
    },
    {
      "code": "for a, b in product(\"ab\", [1, 2]):",
      "explain": "Every combination of two inputs"
    },
    {
      "code": "    print(a, b)",
