    {
      "code": "people = [(\"Ann\", 31), (\"Bo\", 25), (\"Cy\", 40)]",
      "explain": "Name and age pairs"
    },
    {
      "code": "by_age = sorted(people, key=lambda p: p[1])",
      "explain": "Sort by the second field"
    },
    {
      "code": "oldest = max(people, key=lambda p: p[1])",
      "explain": "Find the oldest person"
    },
    {
      "code": "print(by_age[0], oldest)",
      "explain": "Shows Bo's pair and Cy's pair"
    },
    {
