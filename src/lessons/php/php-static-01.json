      "code": "<?php",
      "explain": "Start PHP mode"
    },
    {
      "code": "class Counter {",
      "explain": "Class with shared state"
    },
    {
      "code": "    private static int $n = 0;",
      "explain": "One value shared by all instances"
    },
    {
      "code": "    public static function next(): int { return ++self::$n; }",
      "explain": "Call without creating an object"
    },
    {
      "code": "}",
      "explain": "End of class"
    },
    {
      "code": "Counter::next();",
      "explain": "First call returns 1"
    },
    {
      "code": "echo Counter::next();",
      "explain": "Prints 2"
    }
  ]
