  "chunks": [
    {
      "code": "<?php",
      "explain": "Start PHP mode"
    },
    {
      "code": "$plain = 's3cret-pass';",
      "explain": "Never store this directly"
    },
    {
      "code": "$hash = password_hash($plain, PASSWORD_DEFAULT);",
      "explain": "Salted, slow hash for storage"
    },
    {
      "code": "var_dump(password_verify($plain, $hash));",
      "explain": "Correct password: bool(true)"
    },
    {
      "code": "var_dump(password_verify('wrong', $hash));",
      "explain": "Wrong password: bool(false)"
    }
  ]
