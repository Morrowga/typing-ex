  "chunks": [
    {
      "code": "select c.name, o.id as order_id",
      "explain": "Pick the customer and order id"
    },
    {
      "code": "from customers c",
      "explain": "Start from every customer"
    },
    {
      "code": "left join orders o",
      "explain": "Bring in orders, if any exist"
    },
    {
      "code": "  on o.customer_id = c.id;",
