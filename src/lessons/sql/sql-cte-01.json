{
  "id": "sql-cte-01",
  "category": "SQL",
  "topic": "CTE with WITH",
  "level": 2,
  "tags": [
    "cte",
    "with"
  ],
  "chunks": [
    {
      "code": "with customer_totals as (",
      "explain": "Name a temporary result set"
    },
    {
      "code": "  select customer_id, sum(total) as spent",
      "explain": "Sum the totals per customer"
    },
    {
      "code": "  from orders",
      "explain": "Read from orders"
    },
    {
      "code": "  group by customer_id",
      "explain": "One row per customer"
    },
    {
      "code": ")",
      "explain": "End of the temporary result"
    },
    {
      "code": "select c.name, t.spent",
      "explain": "Choose the name and amount spent"
    },
    {
      "code": "from customer_totals t join customers c on c.id = t.customer_id;",
      "explain": "Join the CTE back to customers"
    }
  ]
}
