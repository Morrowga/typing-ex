{
  "id": "sql-top-n-01",
  "category": "SQL",
  "topic": "Top N per Group",
  "level": 2,
  "tags": [
    "window",
    "top n"
  ],
  "chunks": [
    {
      "code": "with ranked as (",
      "explain": "Name a temporary result"
    },
    {
      "code": "  select name, department, salary,",
      "explain": "Choose the employee columns"
    },
    {
      "code": "    row_number() over (partition by department order by salary desc) as rn",
      "explain": "Rank within each department"
    },
    {
      "code": "  from employees",
      "explain": "Read from employees"
    },
    {
      "code": ")",
      "explain": "End of the temporary result"
    },
    {
      "code": "select name, department, salary from ranked where rn <= 2;",
      "explain": "Keep the first two per department"
    }
  ]
}
