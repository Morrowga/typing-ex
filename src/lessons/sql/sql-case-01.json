  "chunks": [
    {
      "code": "select name, price,",
      "explain": "Show the name and price"
    },
    {
      "code": "  case",
      "explain": "Start a multi-way choice"
    },
    {
      "code": "    when price >= 100 then 'premium'",
      "explain": "Premium when the price is 100 or more"
    },
    {
      "code": "    when price >= 30 then 'standard'",
      "explain": "Standard when the price is 30 or more"
    },
    {
      "code": "    else 'budget'",
      "explain": "Budget for everything else"
    },
    {
      "code": "  end as tier",
      "explain": "Finish the choice and name the column"
    },
    {
      "code": "from products;",
      "explain": "Read from the products table"
    }
  ]
}
