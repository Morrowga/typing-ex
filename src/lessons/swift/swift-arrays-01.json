{
  "id": "swift-arrays-01",
  "category": "Swift",
  "topic": "Array Basics",
  "level": 1,
  "tags": [
    "array",
    "collection"
  ],
  "chunks": [
    {
      "code": "var fruits = [\"apple\", \"pear\", \"plum\"]",
      "explain": "A mutable array of strings"
    },
    {
      "code": "fruits.append(\"fig\")",
      "explain": "Add an item at the end"
    },
    {
      "code": "fruits.insert(\"kiwi\", at: 0)",
      "explain": "Insert at the front"
    },
    {
      "code": "let first = fruits[0]",
      "explain": "Read an item by index"
    },
    {
      "code": "fruits.remove(at: 1)",
      "explain": "Remove the item at index 1"
    },
    {
      "code": "print(fruits.count, first)",
      "explain": "Show the count and first item"
    }
  ]
}
