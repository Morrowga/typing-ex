      "code": "find . -name '*.py' -exec wc -l {} \\;",
      "explain": "Run wc on each Python file"
    },
    {
      "code": "find . -name '*.sh' -exec chmod +x {} +",
      "explain": "Batch chmod on all scripts"
    },
    {
      "code": "find /var/log -name '*.gz' -mtime +30",
      "explain": "Compressed logs older than 30 days"
    },
    {
      "code": "find . -type f -empty",
      "explain": "List empty files"
    },
    {
