{
  "id": "kotlin-mapfilter-01",
  "category": "Kotlin",
  "topic": "map and filter",
  "level": 2,
  "tags": [
    "collections",
    "map",
    "filter"
  ],
  "chunks": [
    {
      "code": "val nums = listOf(1, 2, 3, 4, 5, 6)",
      "explain": "Source numbers"
    },
    {
      "code": "val evens = nums.filter { it % 2 == 0 }",
      "explain": "Keep only even numbers"
    },
    {
      "code": "val squares = evens.map { it * it }",
      "explain": "Square each even number"
    },
    {
      "code": "println(squares)",
      "explain": "Prints [4, 16, 36]"
    },
    {
      "code": "println(nums.any { it > 5 })",
      "explain": "Is any element above 5?"
    },
    {
      "code": "println(nums.all { it > 0 })",
      "explain": "Are all elements positive?"
    }
  ]
}
