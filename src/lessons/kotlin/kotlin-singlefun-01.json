  "chunks": [
    {
      "code": "fun square(x: Int) = x * x",
      "explain": "Body is a single expression"
    },
    {
      "code": "fun isEven(n: Int) = n % 2 == 0",
      "explain": "Return type Boolean is inferred"
    },
    {
      "code": "fun shout(s: String) = s.uppercase() + \"!\"",
      "explain": "Inferred String return type"
    },
    {
      "code": "println(square(6))",
      "explain": "Prints 36"
    },
    {
      "code": "println(isEven(7))",
      "explain": "Prints false"
