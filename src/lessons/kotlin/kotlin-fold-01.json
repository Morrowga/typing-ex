{
  "id": "kotlin-fold-01",
  "category": "Kotlin",
  "topic": "fold and reduce",
  "level": 2,
  "tags": [
    "collections",
    "fold",
    "reduce"
  ],
  "chunks": [
    {
      "code": "val prices = listOf(5.5, 2.0, 7.25)",
      "explain": "Item prices"
    },
    {
      "code": "val total = prices.fold(0.0) { acc, p -> acc + p }",
      "explain": "Start at 0.0 and accumulate"
    },
    {
      "code": "val biggest = prices.reduce { a, b -> if (a > b) a else b }",
      "explain": "Keep the larger each step"
    },
    {
      "code": "println(total)",
      "explain": "Prints 14.75"
    },
    {
      "code": "println(biggest)",
      "explain": "Prints 7.25"
    },
    {
      "code": "println(prices.sumOf { it * 2 })",
      "explain": "Sum a computed value"
    }
  ]
}
